# ── Core ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://username:password@localhost:5432/rec0ded88
PORT=5000
# development locally; set to production only on the deployed host
NODE_ENV=development

# ── Sessions ───────────────────────────────────────────────────────
# Canonical signing key — required. All admin/player HMAC cookies + JWTs
# fall back to this if a dedicated secret isn't set.
SESSION_SECRET=replace_with_strong_random_secret
# Optional dedicated secrets (recommended in prod to split trust domains)
# ADMIN_SESSION_SECRET=
# PLAYER_SESSION_SECRET=
# Used to sign the short-lived cross-domain launch token (popup handoff).
JWT_SECRET=replace_with_strong_random_jwt_secret
# Optional: share the session cookie across every grudge-studio.com subdomain.
# Defaults to .grudge-studio.com when NODE_ENV=production.
# PLAYER_COOKIE_DOMAIN=.grudge-studio.com

# ── Admin ──────────────────────────────────────────────────────────
ADMIN_PASSCODE=replace_with_strong_admin_passcode

# ── CORS + Embeddable modal allowlist ──────────────────────────────
# Hosts allowed to call /api/* with credentials.
CORS_ORIGINS=https://grudgewarlords.com,https://grudge-studio.com,https://id.grudge-studio.com,https://dash.grudge-studio.com,https://ai.grudge-studio.com,https://coder.grudge-studio.com,https://browse.grudge-studio.com,https://grudge-crafting.puter.site,https://grudge-studio-forge.vercel.app,https://betta-grudgedev.replit.app,http://localhost:5173
# Hosts allowed to open /auth/popup and receive launch JWTs via postMessage.
# Falls back to CORS_ORIGINS when not set.
AUTH_ALLOWED_ORIGINS=https://grudgewarlords.com,https://grudge-studio.com,https://id.grudge-studio.com,https://dash.grudge-studio.com,https://ai.grudge-studio.com,https://coder.grudge-studio.com,https://grudge-studio-forge.vercel.app,https://grudge-crafting.puter.site

# Public auth domain (OAuth callbacks + sign-in page). Never use railway.app here.
AUTH_PUBLIC_URL=https://id.grudge-studio.com
# Alias used by older configs — AUTH_PUBLIC_URL takes precedence when set.
AUTH_POPUP_HOST=https://id.grudge-studio.com

# ── Discord ───────────────────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional override — defaults to ${AUTH_PUBLIC_URL}/api/auth/discord/callback
DISCORD_REDIRECT_URI=https://id.grudge-studio.com/auth/discord/callback
# Chat/score announcement webhook (separate from OAuth)
DISCORD_ENGINE_WEBHOOK_URL=

# ── GitHub ────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://id.grudge-studio.com/auth/github/callback

# ── Google ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://id.grudge-studio.com/auth/google/callback

# ── Twilio (phone OTP via Verify service) ─────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=

# ── Phantom Connect (Browser SDK) ─────────────────────────────────
# App ID from Phantom Portal → portal.phantom.com
VITE_PHANTOM_APP_ID=656b4ef2-7acc-44fe-bec7-4b288cfdd2e9

# ── Solana / Web3 ──────────────────────────────────────────────────
# RPC endpoint — Helius, QuickNode, etc. for production.
SOLANA_RPC_URL=https://api.devnet.solana.com
# "devnet" | "mainnet-beta"
SOLANA_NETWORK=devnet

# Platform treasury wallet — receives SOL from swaps, holds platform funds.
# Base58-encoded keypair JSON. Generate with: solana-keygen new --outfile treasury.json
GRUDGE_SOL_WALLET=

# Admin AI agent operational key — co-signs reward mints, runs reconciliation.
# Limited authority: cannot withdraw without master approval.
ADMIN_AI_WALLET_KEY=

# Master admin (Racalvin) private key — emergency withdraw, pause, rate adjust.
# NEVER used by automated systems. Only for manual admin operations.
ADMIN_WALLET_PRIVATE_KEY=

# GBUX SPL token mint address (created after contract deploy)
GBUX_TOKEN_MINT=

# ── Frontend build-time ────────────────────────────────────────────
VITE_WS_URL=wss://ws.grudge-studio.com
# Landing page outbound links. Override per-deploy if hostnames change.
VITE_WARLORDS_URL=https://grudgewarlords.com
VITE_DISCORD_URL=https://discord.gg/grudge
