{
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/public",
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=6144"
    }
  },
  "redirects": [
    {
      "source": "/island",
      "destination": "https://grudgewarlords.com/island",
      "permanent": false
    },
    {
      "source": "/island/:path*",
      "destination": "https://grudgewarlords.com/island/:path*",
      "permanent": false
    },
    {
      "source": "/forge",
      "destination": "https://forge.grudge-studio.com",
      "permanent": false
    },
    {
      "source": "/forge/:path*",
      "destination": "https://forge.grudge-studio.com/:path*",
      "permanent": false
    },
    {
      "source": "/grudges",
      "destination": "https://grudges.grudge-studio.com",
      "permanent": false
    },
    {
      "source": "/grudges/:path*",
      "destination": "https://grudges.grudge-studio.com/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "fleet.grudge-studio.com" }],
      "destination": "https://grudge-fleet-harbor.grudge.workers.dev/"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "fleet.grudge-studio.com" }],
      "destination": "https://grudge-fleet-harbor.grudge.workers.dev/:path*"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "conan.grudge-studio.com" }],
      "destination": "/conan"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "character.grudge-studio.com" }],
      "destination": "/roster"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "characters.grudge-studio.com" }],
      "destination": "/viewer"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "grudge6.grudge-studio.com" }],
      "destination": "/viewer"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "id.grudge-studio.com" }],
      "destination": "https://the-engine.up.railway.app/api/auth/page"
    },
    {
      "source": "/api/auth",
      "destination": "/api/auth/page"
    },
    {
      "source": "/api/auth/:path*",
      "has": [{ "type": "host", "value": "id.grudge-studio.com" }],
      "destination": "https://the-engine.up.railway.app/api/auth/:path*"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "https://the-engine.up.railway.app/api/auth/:path*"
    },
    {
      "source": "/login",
      "has": [{ "type": "host", "value": "id.grudge-studio.com" }],
      "destination": "https://the-engine.up.railway.app/login"
    },
    {
      "source": "/auth/:path*",
      "has": [{ "type": "host", "value": "id.grudge-studio.com" }],
      "destination": "https://the-engine.up.railway.app/api/auth/:path*"
    },
    {
      "source": "/api/me/:path*",
      "destination": "https://the-engine.up.railway.app/api/me/:path*"
    },
    {
      "source": "/api/web3/:path*",
      "destination": "https://the-engine.up.railway.app/api/web3/:path*"
    },
    {
      "source": "/api/challenges/:path*",
      "destination": "https://the-engine.up.railway.app/api/challenges/:path*"
    },
    {
      "source": "/api/friends/:path*",
      "destination": "https://the-engine.up.railway.app/api/friends/:path*"
    },
    {
      "source": "/api/transactions",
      "destination": "https://the-engine.up.railway.app/api/transactions"
    },
    {
      "source": "/api/chat/:path*",
      "destination": "https://the-engine.up.railway.app/api/chat/:path*"
    },
    {
      "source": "/api/treaty/:path*",
      "destination": "https://the-engine.up.railway.app/api/treaty/:path*"
    },
    {
      "source": "/api/portal-admin/:path*",
      "destination": "https://the-engine.up.railway.app/api/admin/:path*"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "https://the-engine.up.railway.app/api/admin/:path*"
    },

    {
      "source": "/api/status",
      "destination": "https://the-engine.up.railway.app/api/fleet/health"
    },
    {
      "source": "/api/characters/:path*",
      "destination": "https://the-engine.up.railway.app/api/characters/:path*"
    },
    {
      "source": "/api/assets/:path*",
      "destination": "https://assets.grudge-studio.com/:path*"
    },
    {
      "source": "/api/:path((?!games$|games/|platforms$|rom-proxy$|health$|admin/|portal-admin/).*)",
      "destination": "https://the-engine.up.railway.app/api/:path"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://ws.grudge-studio.com/ws/:path*"
    },
    {
      "source": "/((?!api/|embed/).*)",
      "has": [{ "type": "host", "value": "id.grudge-studio.com" }],
      "destination": "/api/auth/page"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "forge.grudge-studio.com" }],
      "destination": "/studio-forge"
    },
    {
      "source": "/((?!api/|ws/|emulator\\.html|catalog/|assets/|games/|models/|embed/|voxgrudge/|vendor/|favicon|apple-touch|grudge-sso|grudge-auth|grudge-game-bootstrap|sw\\.js|manifest).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/catalog/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/games",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/platforms",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js.puter.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://static.cloudflareinsights.com https://*.grudge-studio.com https://grudachain-rho.vercel.app https://*.vercel.app https://vercel.live https://phantom.app https://*.phantom.app; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://vercel.live; font-src 'self' https://fonts.gstatic.com https://vercel.live data:; img-src 'self' data: blob: https: http:; connect-src 'self' https: wss: https://api.phantom.app https://*.phantom.app https://static.cloudflareinsights.com https://cloudflareinsights.com https://vercel.live; frame-src 'self' https://*.puter.com https://*.puter.site https://grudge-studio.com https://grudgewarlords.com https://browse.grudge-studio.com https://*.grudge-studio.com https://*.vercel.app https://vercel.live https://phantom.app https://*.phantom.app; media-src 'self' https://assets.grudge-studio.com blob:; worker-src 'self' blob:" }
      ]
    }
  ]
}
